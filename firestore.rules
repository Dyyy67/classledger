rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Classrooms: only the teacher who owns them
    match /classrooms/{classroomId} {
      allow read, write: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid;
    }

    // Students: only accessible if the teacher owns the classroom
    match /students/{studentId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid;
    }

    // Campaigns: same classroom-ownership check
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid;
    }

    // Transactions: same classroom-ownership check
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid;
    }
  }
}
